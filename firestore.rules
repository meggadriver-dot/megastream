rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'meggadriver@gmail.com'
      );
    }

    // Validation Blueprints
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'name', 'email', 'plan', 'role', 'blocked', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'name', 'email', 'photoUrl', 'plan', 'role', 'blocked',
          'preferredTheme', 'preferredLanguage', 'preferredQuality',
          'parentalControl', 'notificationsEnabled', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 180
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500))
        && data.plan in ['free', 'monthly', 'quarterly', 'annual']
        && data.role in ['user', 'admin']
        && data.blocked is bool
        && (!('preferredTheme' in data) || data.preferredTheme in ['cinematografico', 'neon-roxo', 'minimalista', 'gold-premium', '3d-glass'])
        && (!('preferredLanguage' in data) || (data.preferredLanguage is string && data.preferredLanguage.size() <= 16))
        && (!('preferredQuality' in data) || (data.preferredQuality is string && data.preferredQuality.size() <= 16))
        && (!('parentalControl' in data) || data.parentalControl is bool)
        && (!('notificationsEnabled' in data) || data.notificationsEnabled is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFavoriteItem(data, userId) {
      return data.keys().hasAll(['userId', 'tmdbId', 'mediaType', 'title', 'createdAt'])
        && data.keys().hasOnly(['userId', 'tmdbId', 'mediaType', 'title', 'posterPath', 'voteAverage', 'releaseYear', 'createdAt'])
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && data.tmdbId is number && data.tmdbId > 0
        && data.mediaType in ['movie', 'tv']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && (!('posterPath' in data) || (data.posterPath is string && data.posterPath.size() <= 400))
        && (!('voteAverage' in data) || (data.voteAverage is number && data.voteAverage >= 0 && data.voteAverage <= 10))
        && (!('releaseYear' in data) || (data.releaseYear is string && data.releaseYear.size() <= 10))
        && data.createdAt is timestamp;
    }

    function isValidHistoryItem(data, userId) {
      return data.keys().hasAll(['userId', 'tmdbId', 'mediaType', 'title', 'progressPercent', 'watchedAt'])
        && data.keys().hasOnly([
          'userId', 'tmdbId', 'mediaType', 'title', 'posterPath', 'backdropPath',
          'progressPercent', 'seasonNumber', 'episodeNumber', 'playerProvider', 'watchedAt'
        ])
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && data.tmdbId is number && data.tmdbId > 0
        && data.mediaType in ['movie', 'tv']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && (!('posterPath' in data) || (data.posterPath is string && data.posterPath.size() <= 400))
        && (!('backdropPath' in data) || (data.backdropPath is string && data.backdropPath.size() <= 400))
        && data.progressPercent is number && data.progressPercent >= 0 && data.progressPercent <= 100
        && (!('seasonNumber' in data) || (data.seasonNumber is number && data.seasonNumber >= 0))
        && (!('episodeNumber' in data) || (data.episodeNumber is number && data.episodeNumber >= 0))
        && (!('playerProvider' in data) || (data.playerProvider is string && data.playerProvider.size() <= 32))
        && data.watchedAt is timestamp;
    }

    function isValidChannel(data, channelId) {
      return data.keys().hasAll(['id', 'name', 'category', 'streamUrl', 'active', 'createdAt'])
        && data.keys().hasOnly(['id', 'name', 'category', 'streamUrl', 'logoUrl', 'description', 'active', 'createdAt'])
        && data.id is string && data.id == channelId && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.category in ['Notícias', 'Esportes', 'Entretenimento', 'Filmes', 'Variedades', 'Infantil']
        && data.streamUrl is string && data.streamUrl.size() >= 8 && data.streamUrl.size() <= 500
        && (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 500))
        && (!('description' in data) || (data.description is string && data.description.size() <= 300))
        && data.active is bool
        && data.createdAt is timestamp;
    }

    function isValidSubscription(data, userId) {
      return data.keys().hasAll(['userId', 'planId', 'status', 'amountBrl', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'planId', 'status', 'amountBrl', 'expiresAt', 'updatedAt'])
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && data.planId in ['monthly', 'quarterly', 'annual']
        && data.status in ['pending_gateway', 'active', 'canceled', 'expired']
        && data.amountBrl is number && data.amountBrl >= 0
        && (!('expiresAt' in data) || data.expiresAt is timestamp)
        && data.updatedAt is timestamp;
    }

    function isValidStreamProfile(data, userId, profileId) {
      return data.keys().hasAll([
          'id', 'userId', 'name', 'avatarId', 'avatarUrl', 'hasPin',
          'isKids', 'preferredTheme', 'preferredLanguage', 'preferredQuality',
          'autoplayNext', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'name', 'avatarId', 'avatarUrl', 'hasPin', 'pinHash',
          'isKids', 'preferredTheme', 'preferredLanguage', 'preferredQuality',
          'autoplayNext', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == profileId && isValidId(data.id)
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 40
        && data.avatarId is string && data.avatarId.size() >= 1 && data.avatarId.size() <= 64
        && data.avatarUrl is string && data.avatarUrl.size() >= 1 && data.avatarUrl.size() <= 45000
        && data.hasPin is bool
        && (!('pinHash' in data) || (data.pinHash is string && data.pinHash.size() <= 128))
        && data.isKids is bool
        && data.preferredTheme in ['cinematografico', 'neon-roxo', 'minimalista', 'gold-premium', '3d-glass']
        && data.preferredLanguage is string && data.preferredLanguage.size() >= 2 && data.preferredLanguage.size() <= 16
        && data.preferredQuality is string && data.preferredQuality.size() >= 2 && data.preferredQuality.size() <= 16
        && data.autoplayNext is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSiteConfig(data) {
      return data.keys().hasAll([
          'siteName', 'siteSlogan', 'defaultTheme', 'announcementEnabled',
          'enableChannels', 'enableAiPage', 'enablePlansPage', 'maintenanceMode',
          'footerText', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'siteName', 'siteSlogan', 'logoUrl', 'defaultTheme', 'accentColorHex',
          'announcementEnabled', 'announcementText', 'enableChannels',
          'enableAiPage', 'enablePlansPage', 'maintenanceMode', 'footerText', 'updatedAt'
        ])
        && data.siteName is string && data.siteName.size() >= 1 && data.siteName.size() <= 40
        && data.siteSlogan is string && data.siteSlogan.size() >= 1 && data.siteSlogan.size() <= 100
        && (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 500))
        && data.defaultTheme in ['cinematografico', 'neon-roxo', 'minimalista', 'gold-premium', '3d-glass']
        && (!('accentColorHex' in data) || (data.accentColorHex is string && data.accentColorHex.size() <= 12))
        && data.announcementEnabled is bool
        && (!('announcementText' in data) || (data.announcementText is string && data.announcementText.size() <= 180))
        && data.enableChannels is bool
        && data.enableAiPage is bool
        && data.enablePlansPage is bool
        && data.maintenanceMode is bool
        && data.footerText is string && data.footerText.size() >= 1 && data.footerText.size() <= 120
        && data.updatedAt is timestamp;
    }

    function isValidCustomMedia(data, mediaId) {
      return data.keys().hasAll([
          'id', 'tmdbId', 'mediaType', 'title', 'overview', 'featured', 'active', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'tmdbId', 'mediaType', 'title', 'originalTitle', 'overview',
          'posterPath', 'backdropPath', 'releaseYear', 'voteAverage',
          'customStreamUrl', 'featured', 'active', 'updatedAt'
        ])
        && data.id is string && data.id == mediaId && isValidId(data.id)
        && data.tmdbId is number && data.tmdbId > 0
        && data.mediaType in ['movie', 'tv']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && (!('originalTitle' in data) || (data.originalTitle is string && data.originalTitle.size() <= 160))
        && data.overview is string && data.overview.size() <= 1000
        && (!('posterPath' in data) || data.posterPath == null || (data.posterPath is string && data.posterPath.size() <= 500))
        && (!('backdropPath' in data) || data.backdropPath == null || (data.backdropPath is string && data.backdropPath.size() <= 500))
        && (!('releaseYear' in data) || (data.releaseYear is string && data.releaseYear.size() <= 8))
        && (!('voteAverage' in data) || (data.voteAverage is number && data.voteAverage >= 0 && data.voteAverage <= 10))
        && (!('customStreamUrl' in data) || (data.customStreamUrl is string && data.customStreamUrl.size() <= 500))
        && data.featured is bool
        && data.active is bool
        && data.updatedAt is timestamp;
    }

    function isValidPlayerSettings(data) {
      return data.keys().hasAll(['defaultDomain', 'defaultPlayer', 'defaultColorHex', 'updatedAt'])
        && data.keys().hasOnly([
          'sourceMode', 'defaultDomain', 'fallbackDomain', 'autoFallback',
          'defaultPlayer', 'defaultColorHex', 'customEmbedMovieTemplate',
          'customEmbedTvTemplate', 'embedTimeoutSeconds', 'updatedAt'
        ])
        && (!('sourceMode' in data) || data.sourceMode in ['megaembed', 'custom_template'])
        && data.defaultDomain in ['mgeb.lat', 'mgeb.space']
        && (!('fallbackDomain' in data) || data.fallbackDomain in ['mgeb.lat', 'mgeb.space'])
        && (!('autoFallback' in data) || data.autoFallback is bool)
        && data.defaultPlayer in ['vidstack', 'megaplay', 'megatube', 'clappr']
        && data.defaultColorHex is string && data.defaultColorHex.size() >= 3 && data.defaultColorHex.size() <= 12
        && (!('customEmbedMovieTemplate' in data) || (data.customEmbedMovieTemplate is string && data.customEmbedMovieTemplate.size() <= 500))
        && (!('customEmbedTvTemplate' in data) || (data.customEmbedTvTemplate is string && data.customEmbedTvTemplate.size() <= 500))
        && (!('embedTimeoutSeconds' in data) || (data.embedTimeoutSeconds is number && data.embedTimeoutSeconds >= 5 && data.embedTimeoutSeconds <= 30))
        && data.updatedAt is timestamp;
    }

    function isValidSystemSettings(data) {
      return data.keys().hasAll([
          'catalogSource', 'tmdbBaseUrl', 'tmdbImageBaseUrl', 'tmdbLanguage',
          'tmdbImageQuality', 'includeAdult', 'cacheTtlMinutes', 'aiMode',
          'aiMaxRecommendations', 'allowRegistration', 'requireAuthForPlayer',
          'allowGuestFavorites', 'maxProfilesPerAccount', 'defaultUserPlan',
          'maintenanceMessage', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'catalogSource', 'tmdbBaseUrl', 'tmdbImageBaseUrl', 'tmdbLanguage',
          'tmdbImageQuality', 'includeAdult', 'cacheTtlMinutes', 'aiMode',
          'aiMaxRecommendations', 'allowRegistration', 'requireAuthForPlayer',
          'allowGuestFavorites', 'maxProfilesPerAccount', 'defaultUserPlan',
          'maintenanceMessage', 'updatedAt'
        ])
        && data.catalogSource in ['auto', 'tmdb', 'demo', 'custom_only']
        && data.tmdbBaseUrl is string && data.tmdbBaseUrl.size() >= 8 && data.tmdbBaseUrl.size() <= 300
        && data.tmdbImageBaseUrl is string && data.tmdbImageBaseUrl.size() >= 8 && data.tmdbImageBaseUrl.size() <= 300
        && data.tmdbLanguage in ['pt-BR', 'en-US', 'es-ES']
        && data.tmdbImageQuality in ['w342', 'w500', 'w780']
        && data.includeAdult is bool
        && data.cacheTtlMinutes is number && data.cacheTtlMinutes >= 1 && data.cacheTtlMinutes <= 1440
        && data.aiMode in ['auto', 'gemini', 'catalog_smart', 'disabled']
        && data.aiMaxRecommendations is number && data.aiMaxRecommendations >= 4 && data.aiMaxRecommendations <= 24
        && data.allowRegistration is bool
        && data.requireAuthForPlayer is bool
        && data.allowGuestFavorites is bool
        && data.maxProfilesPerAccount is number && data.maxProfilesPerAccount >= 1 && data.maxProfilesPerAccount <= 8
        && data.defaultUserPlan in ['free', 'monthly', 'quarterly', 'annual']
        && data.maintenanceMessage is string && data.maintenanceMessage.size() >= 1 && data.maintenanceMessage.size() <= 240
        && data.updatedAt is timestamp;
    }

    function isValidAdminSecrets(data) {
      return data.keys().hasAll(['updatedAt'])
        && data.keys().hasOnly(['tmdbAccessToken', 'geminiApiKey', 'updatedAt'])
        && (!('tmdbAccessToken' in data) || (data.tmdbAccessToken is string && data.tmdbAccessToken.size() <= 500))
        && (!('geminiApiKey' in data) || (data.geminiApiKey is string && data.geminiApiKey.size() <= 500))
        && data.updatedAt is timestamp;
    }

    function isValidAdminMarker(data, adminId) {
      return data.keys().hasAll(['uid', 'email', 'grantedAt'])
        && data.keys().hasOnly(['uid', 'email', 'grantedAt'])
        && data.uid is string && data.uid == adminId && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 180
        && data.grantedAt is timestamp;
    }

    // Collection: /users/{userId}
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().role == 'user'
        && incoming().blocked == false
        && incoming().plan == 'free'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().blocked == existing().blocked
            && incoming().plan == existing().plan
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'photoUrl', 'preferredTheme', 'preferredLanguage',
              'preferredQuality', 'parentalControl', 'notificationsEnabled', 'updatedAt'
            ])
          )
        );
      allow delete: if isAdmin() && isValidId(userId);

      // Subcollection: /users/{userId}/favorites/{favoriteId}
      match /favorites/{favoriteId} {
        allow get: if isValidId(userId) && isValidId(favoriteId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin()) && resource.data.userId == userId;
        allow create: if isSignedIn()
          && isValidId(userId) && isValidId(favoriteId)
          && isOwner(userId)
          && isValidFavoriteItem(incoming(), userId)
          && incoming().createdAt == request.time;
        allow update: if isSignedIn()
          && isValidId(userId) && isValidId(favoriteId)
          && isOwner(userId)
          && isValidFavoriteItem(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().tmdbId == existing().tmdbId
          && incoming().mediaType == existing().mediaType
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'posterPath', 'voteAverage', 'releaseYear'
          ]);
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(favoriteId) && (isOwner(userId) || isAdmin());
      }

      // Subcollection: /users/{userId}/history/{historyId}
      match /history/{historyId} {
        allow get: if isValidId(userId) && isValidId(historyId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin()) && resource.data.userId == userId;
        allow create: if isSignedIn()
          && isValidId(userId) && isValidId(historyId)
          && isOwner(userId)
          && isValidHistoryItem(incoming(), userId)
          && incoming().watchedAt == request.time;
        allow update: if isSignedIn()
          && isValidId(userId) && isValidId(historyId)
          && isOwner(userId)
          && isValidHistoryItem(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().tmdbId == existing().tmdbId
          && incoming().mediaType == existing().mediaType
          && incoming().watchedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'posterPath', 'backdropPath', 'progressPercent',
            'seasonNumber', 'episodeNumber', 'playerProvider', 'watchedAt'
          ]);
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(historyId) && (isOwner(userId) || isAdmin());
      }

      // Subcollection: /users/{userId}/profiles/{profileId}
      match /profiles/{profileId} {
        allow get: if isValidId(userId) && isValidId(profileId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin()) && resource.data.userId == userId;
        allow create: if isSignedIn()
          && isValidId(userId) && isValidId(profileId)
          && isOwner(userId)
          && isValidStreamProfile(incoming(), userId, profileId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isSignedIn()
          && isValidId(userId) && isValidId(profileId)
          && isValidStreamProfile(incoming(), userId, profileId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (
              isOwner(userId)
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'name', 'avatarId', 'avatarUrl', 'hasPin', 'pinHash',
                'isKids', 'preferredTheme', 'preferredLanguage',
                'preferredQuality', 'autoplayNext', 'updatedAt'
              ])
            )
          );
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(profileId) && (isOwner(userId) || isAdmin());
      }
    }

    // Collection: /channels/{channelId}
    match /channels/{channelId} {
      allow get: if isValidId(channelId) && (existing().active == true || isAdmin());
      allow list: if resource.data.active == true || isAdmin();
      allow create: if isAdmin() && isValidId(channelId) && isValidChannel(incoming(), channelId) && incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidId(channelId) && isValidChannel(incoming(), channelId) && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(channelId);
    }

    // Collection: /subscriptions/{userId}
    match /subscriptions/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidSubscription(incoming(), userId)
        && incoming().status == 'pending_gateway'
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidSubscription(incoming(), userId)
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().userId == existing().userId
            && incoming().status in ['pending_gateway', 'canceled']
            && incoming().diff(existing()).affectedKeys().hasOnly(['planId', 'status', 'amountBrl', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Collection: /admins/{adminId}
    match /admins/{adminId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin()
        && isValidId(adminId)
        && isValidAdminMarker(incoming(), adminId)
        && incoming().grantedAt == request.time;
      allow delete: if isAdmin() && isValidId(adminId) && request.auth.uid != adminId;
    }

    // Collection: /siteConfig/{configId}
    match /siteConfig/{configId} {
      allow get: if isValidId(configId);
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && isValidId(configId)
        && isValidSiteConfig(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(configId);
    }

    // Collection: /playerSettings/{configId}
    match /playerSettings/{configId} {
      allow get: if isValidId(configId);
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && isValidId(configId)
        && isValidPlayerSettings(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(configId);
    }

    // Collection: /systemSettings/{configId}
    match /systemSettings/{configId} {
      allow get: if isValidId(configId);
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && isValidId(configId)
        && isValidSystemSettings(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(configId);
    }

    // Collection: /adminSecrets/{secretId}
    match /adminSecrets/{secretId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin()
        && isValidId(secretId)
        && isValidAdminSecrets(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(secretId);
    }

    // Collection: /customCatalog/{mediaId}
    match /customCatalog/{mediaId} {
      allow get: if isValidId(mediaId) && (existing().active == true || isAdmin());
      allow list: if resource.data.active == true || isAdmin();
      allow create, update: if isAdmin()
        && isValidId(mediaId)
        && isValidCustomMedia(incoming(), mediaId)
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(mediaId);
    }

    // Connection check document (read-only ping)
    match /test/connection {
      allow get: if true;
    }
  }
}
