{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated MegaStream user account and preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 180 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "plan": { "type": "string", "enum": ["free", "monthly", "quarterly", "annual"] },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "blocked": { "type": "boolean" },
        "preferredTheme": { "type": "string", "enum": ["cinematografico", "neon-roxo", "minimalista", "gold-premium", "3d-glass"] },
        "preferredLanguage": { "type": "string", "maxLength": 16 },
        "preferredQuality": { "type": "string", "maxLength": 16 },
        "parentalControl": { "type": "boolean" },
        "notificationsEnabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email", "plan", "role", "blocked", "createdAt", "updatedAt"]
    },
    "FavoriteItem": {
      "title": "FavoriteItem",
      "description": "Movie or TV series saved in a user's Minha Lista.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tmdbId": { "type": "number" },
        "mediaType": { "type": "string", "enum": ["movie", "tv"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "posterPath": { "type": "string", "maxLength": 400 },
        "voteAverage": { "type": "number" },
        "releaseYear": { "type": "string", "maxLength": 10 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "tmdbId", "mediaType", "title", "createdAt"]
    },
    "HistoryItem": {
      "title": "HistoryItem",
      "description": "Playback history entry with TMDB reference and progress.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tmdbId": { "type": "number" },
        "mediaType": { "type": "string", "enum": ["movie", "tv"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "posterPath": { "type": "string", "maxLength": 400 },
        "backdropPath": { "type": "string", "maxLength": 400 },
        "progressPercent": { "type": "number" },
        "seasonNumber": { "type": "number" },
        "episodeNumber": { "type": "number" },
        "playerProvider": { "type": "string", "maxLength": 32 },
        "watchedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "tmdbId", "mediaType", "title", "progressPercent", "watchedAt"]
    },
    "LiveChannel": {
      "title": "LiveChannel",
      "description": "Admin-registered authorized live TV channel.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "category": { "type": "string", "enum": ["Notícias", "Esportes", "Entretenimento", "Filmes", "Variedades", "Infantil"] },
        "streamUrl": { "type": "string", "minLength": 8, "maxLength": 500 },
        "logoUrl": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "maxLength": 300 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "category", "streamUrl", "active", "createdAt"]
    },
    "SubscriptionRecord": {
      "title": "SubscriptionRecord",
      "description": "User subscription plan state and billing readiness metadata.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "planId": { "type": "string", "enum": ["monthly", "quarterly", "annual"] },
        "status": { "type": "string", "enum": ["pending_gateway", "active", "canceled", "expired"] },
        "amountBrl": { "type": "number" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "planId", "status", "amountBrl", "updatedAt"]
    },
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Trusted admin lookup document keyed by user UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 180 },
        "grantedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "grantedAt"]
    },
    "StreamProfile": {
      "title": "StreamProfile",
      "description": "Customizable viewing profile under a user account with optional PIN lock, avatar, kids mode, and theme.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "avatarId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "avatarUrl": { "type": "string", "minLength": 1, "maxLength": 45000 },
        "hasPin": { "type": "boolean" },
        "pinHash": { "type": "string", "maxLength": 128 },
        "isKids": { "type": "boolean" },
        "preferredTheme": { "type": "string", "enum": ["cinematografico", "neon-roxo", "minimalista", "gold-premium", "3d-glass"] },
        "preferredLanguage": { "type": "string", "minLength": 2, "maxLength": 16 },
        "preferredQuality": { "type": "string", "minLength": 2, "maxLength": 16 },
        "autoplayNext": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "name", "avatarId", "avatarUrl", "hasPin", "isKids", "preferredTheme", "preferredLanguage", "preferredQuality", "autoplayNext", "createdAt", "updatedAt"]
    },
    "SiteConfig": {
      "title": "SiteConfig",
      "description": "Global site customization, branding, feature toggles, and announcement settings managed by admins.",
      "type": "object",
      "properties": {
        "siteName": { "type": "string", "minLength": 1, "maxLength": 40 },
        "siteSlogan": { "type": "string", "minLength": 1, "maxLength": 100 },
        "logoUrl": { "type": "string", "maxLength": 500 },
        "defaultTheme": { "type": "string", "enum": ["cinematografico", "neon-roxo", "minimalista", "gold-premium", "3d-glass"] },
        "accentColorHex": { "type": "string", "maxLength": 12 },
        "announcementEnabled": { "type": "boolean" },
        "announcementText": { "type": "string", "maxLength": 180 },
        "enableChannels": { "type": "boolean" },
        "enableAiPage": { "type": "boolean" },
        "enablePlansPage": { "type": "boolean" },
        "maintenanceMode": { "type": "boolean" },
        "footerText": { "type": "string", "minLength": 1, "maxLength": 120 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["siteName", "siteSlogan", "defaultTheme", "announcementEnabled", "enableChannels", "enableAiPage", "enablePlansPage", "maintenanceMode", "footerText", "updatedAt"]
    },
    "CustomMediaItem": {
      "title": "CustomMediaItem",
      "description": "Admin-added or modified movie/series entry or custom stream override.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tmdbId": { "type": "number" },
        "mediaType": { "type": "string", "enum": ["movie", "tv"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "originalTitle": { "type": "string", "maxLength": 160 },
        "overview": { "type": "string", "maxLength": 1000 },
        "posterPath": { "type": "string", "maxLength": 500 },
        "backdropPath": { "type": "string", "maxLength": 500 },
        "releaseYear": { "type": "string", "maxLength": 8 },
        "voteAverage": { "type": "number" },
        "customStreamUrl": { "type": "string", "maxLength": 500 },
        "featured": { "type": "boolean" },
        "active": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tmdbId", "mediaType", "title", "overview", "featured", "active", "updatedAt"]
    },
    "PlayerSettings": {
      "title": "PlayerSettings",
      "description": "Server-side player engine, fast no-Cloudflare source, anti-ad sandbox, domain, WatchaFlix API, fallback, custom template, and timeout settings managed exclusively by administrators.",
      "type": "object",
      "properties": {
        "sourceMode": { "type": "string", "enum": ["myembed", "megaembed", "watchaflix", "custom_template"] },
        "defaultDomain": { "type": "string", "enum": ["mgeb.lat", "mgeb.space"] },
        "fallbackDomain": { "type": "string", "enum": ["mgeb.lat", "mgeb.space"] },
        "autoFallback": { "type": "boolean" },
        "defaultPlayer": { "type": "string", "enum": ["vidstack", "megaplay", "megatube", "clappr"] },
        "defaultColorHex": { "type": "string", "minLength": 3, "maxLength": 12 },
        "myembedBaseUrl": { "type": "string", "minLength": 8, "maxLength": 300 },
        "antiAdSandbox": { "type": "boolean" },
        "watchaflixBaseUrl": { "type": "string", "minLength": 8, "maxLength": 300 },
        "watchaflixLang": { "type": "string", "enum": ["pt", "en"] },
        "customEmbedMovieTemplate": { "type": "string", "maxLength": 500 },
        "customEmbedTvTemplate": { "type": "string", "maxLength": 500 },
        "embedTimeoutSeconds": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["defaultDomain", "defaultPlayer", "defaultColorHex", "updatedAt"]
    },
    "SystemSettings": {
      "title": "SystemSettings",
      "description": "Global API sources, catalog/AI behavior, access policies, and profile limits managed exclusively by administrators.",
      "type": "object",
      "properties": {
        "catalogSource": { "type": "string", "enum": ["auto", "tmdb", "demo", "custom_only"] },
        "tmdbBaseUrl": { "type": "string", "minLength": 8, "maxLength": 300 },
        "tmdbImageBaseUrl": { "type": "string", "minLength": 8, "maxLength": 300 },
        "tmdbLanguage": { "type": "string", "enum": ["pt-BR", "en-US", "es-ES"] },
        "tmdbImageQuality": { "type": "string", "enum": ["w342", "w500", "w780"] },
        "includeAdult": { "type": "boolean" },
        "cacheTtlMinutes": { "type": "number" },
        "aiMode": { "type": "string", "enum": ["auto", "gemini", "catalog_smart", "disabled"] },
        "aiMaxRecommendations": { "type": "number" },
        "allowRegistration": { "type": "boolean" },
        "requireAuthForPlayer": { "type": "boolean" },
        "allowGuestFavorites": { "type": "boolean" },
        "maxProfilesPerAccount": { "type": "number" },
        "defaultUserPlan": { "type": "string", "enum": ["free", "monthly", "quarterly", "annual"] },
        "maintenanceMessage": { "type": "string", "minLength": 1, "maxLength": 240 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "catalogSource",
        "tmdbBaseUrl",
        "tmdbImageBaseUrl",
        "tmdbLanguage",
        "tmdbImageQuality",
        "includeAdult",
        "cacheTtlMinutes",
        "aiMode",
        "aiMaxRecommendations",
        "allowRegistration",
        "requireAuthForPlayer",
        "allowGuestFavorites",
        "maxProfilesPerAccount",
        "defaultUserPlan",
        "maintenanceMessage",
        "updatedAt"
      ]
    },
    "AdminSecrets": {
      "title": "AdminSecrets",
      "description": "Admin-only runtime API token overrides for TMDB and Gemini.",
      "type": "object",
      "properties": {
        "tmdbAccessToken": { "type": "string", "maxLength": 500 },
        "geminiApiKey": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user account profile and personal preferences."
    },
    "/users/{userId}/profiles/{profileId}": {
      "schema": { "$ref": "#/entities/StreamProfile" },
      "description": "Viewer profiles under a user account with avatar, PIN hash, kids mode, and preferences."
    },
    "/users/{userId}/favorites/{favoriteId}": {
      "schema": { "$ref": "#/entities/FavoriteItem" },
      "description": "User saved movies and series in Minha Lista."
    },
    "/users/{userId}/history/{historyId}": {
      "schema": { "$ref": "#/entities/HistoryItem" },
      "description": "User playback history and resume progress."
    },
    "/channels/{channelId}": {
      "schema": { "$ref": "#/entities/LiveChannel" },
      "description": "Authorized live TV channels managed by administrators."
    },
    "/subscriptions/{userId}": {
      "schema": { "$ref": "#/entities/SubscriptionRecord" },
      "description": "User subscription record."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Trusted administrator lookup collection."
    },
    "/siteConfig/{configId}": {
      "schema": { "$ref": "#/entities/SiteConfig" },
      "description": "Global site customization managed exclusively by administrators."
    },
    "/customCatalog/{mediaId}": {
      "schema": { "$ref": "#/entities/CustomMediaItem" },
      "description": "Custom or overridden catalog items managed exclusively by administrators."
    },
    "/playerSettings/{configId}": {
      "schema": { "$ref": "#/entities/PlayerSettings" },
      "description": "Global player domain, engine, custom template, and timeout settings managed exclusively by administrators."
    },
    "/systemSettings/{configId}": {
      "schema": { "$ref": "#/entities/SystemSettings" },
      "description": "Global API sources, AI behavior, and platform security policies managed exclusively by administrators."
    },
    "/adminSecrets/{secretId}": {
      "schema": { "$ref": "#/entities/AdminSecrets" },
      "description": "Admin-only API key overrides never exposed to non-admin users."
    }
  }
}
